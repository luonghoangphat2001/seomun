# POPBiLL EasyFinBank (bank transfer confirmation)
# Keep disabled until API credentials and registered bank accounts are configured.
POPBILL_BANK_ENABLED=false
# The backend reads POPBILL_TEST, not POPBILL_IS_TEST.
# Use a non-production APP_ENV when testing; test mode cannot confirm production payments.
POPBILL_TEST=true
# API partner credentials. Never commit real credentials to this sample.
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
# Korean business registration number: 10 digits, without hyphens.
POPBILL_CORP_NUM=
# POPBiLL login user ID belonging to the business above.
POPBILL_USER_ID=
# POPBiLL Messaging (sender number must be registered in POPBiLL).
POPBILL_SMS_ENABLED=false
POPBILL_SMS_SENDER_NUMBER='01051149344'
# Woori (0020): account must be registered separately in POPBiLL Test/live.
# Account number without hyphens; quote the holder name if it contains spaces.
POPBILL_WOORI_ACCOUNT_NUMBER=
POPBILL_WOORI_ACCOUNT_HOLDER=
# Optional banks: leave blank when unused. No bank password is required here.
POPBILL_HANA_ACCOUNT_NUMBER=
POPBILL_HANA_ACCOUNT_HOLDER=
POPBILL_IM_ACCOUNT_NUMBER=
POPBILL_IM_ACCOUNT_HOLDER=
