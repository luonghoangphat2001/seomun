{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "darkaonline/l5-swagger": "^9.0",
        "dompdf/dompdf": "^3.1",
        "laravel/framework": "^11.0",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.2",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "linkhub/popbill": "^1.68.2",
        "maatwebsite/excel": "^3.1",
        "phpoffice/phpspreadsheet": "^1.30",
        "socialiteproviders/kakao": "^4.3",
        "socialiteproviders/naver": "^4.1",
        "solapi/sdk": "^5.1",
        "spatie/laravel-activitylog": "*",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.46",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "@php -r \"is_dir('storage/api-docs') || mkdir('storage/api-docs', 0755, true);\""  ,
            "@php -r \"copy('resources/swagger/openapi.yml', 'storage/api-docs/api-docs.yaml');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --ansi"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "11.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": ["PKSA-365x-2zjk-pt47"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
